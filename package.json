{
  "name": "pi-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A context-isolated supervisor and subagent runtime for Pi.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bench:isolation": "node benchmarks/isolation-vs-shared/benchmark.ts",
    "check": "npm run typecheck && npm test",
    "dev": "node src/cli.ts",
    "mother": "node src/start-mother.ts",
    "smoke:extension": "node scripts/smoke-extension.mjs",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
